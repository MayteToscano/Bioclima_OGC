<https://maytetoscano.github.io/Bioclima_OGC/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - BioClima OGC Building Blocks" ;
    dct:abstract """Register of OGC Building Blocks for Essential Biodiversity Variables (EBVs),
derived indicators, bioclimatic zonification, data provenance and policy
alignment with the Kunming-Montreal GBF. The pilot dataset is the Start of
Vegetation Active Period in Finland (2001-2018).
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """This register defines BioClima-specific building blocks on top of the
OGC CoverageJSON community standard. It includes:

- A profile of CoverageJSON for BioClima EBV datasets.
- Generic schemas for EBV records and indicator records.
- Concrete EBV datasets for Finnish coniferous and deciduous vegetation.
- The Phenological Change Indicator (PCI) and its bioclimatic zonification,
  each with a Python implementation that the CI can re-run automatically.
- W3C PROV-O provenance schemas for both EBVs and indicators.
- Policy alignment schemas linking indicators to Kunming-Montreal GBF
  targets and SDG 15.

A multilingual SKOS ontology (English, Spanish, Chinese, Romanian) lives
outside the register at /ontology and is referenced from every block by
IRI.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-05-15T13:41:55.246555"^^xsd:dateTime ;
    owl:imports <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.bioclima.coveragejson.bioclima-coverage>,
        <bblocks://ogc.bioclima.ebv.ebv-definition>,
        <bblocks://ogc.bioclima.ebv.vap-coniferous>,
        <bblocks://ogc.bioclima.ebv.vap-deciduous>,
        <bblocks://ogc.bioclima.indicator.bioclimatic-zone>,
        <bblocks://ogc.bioclima.indicator.indicator-definition>,
        <bblocks://ogc.bioclima.indicator.pci>,
        <bblocks://ogc.bioclima.policy.kmgbf-target>,
        <bblocks://ogc.bioclima.policy.policy-alignment>,
        <bblocks://ogc.bioclima.provenance.ebv-provenance>,
        <bblocks://ogc.bioclima.provenance.indicator-provenance> ;
    skos:prefLabel "Building Blocks - BioClima OGC Building Blocks" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://maytetoscano.github.io/Bioclima_OGC/build/bblocks.jsonld> ],
        [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://maytetoscano.github.io/Bioclima_OGC/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://maytetoscano.github.io/Bioclima_OGC/build/bblocks.ttl> ] ;
    foaf:homepage <https://maytetoscano.github.io/Bioclima_OGC/> ;
