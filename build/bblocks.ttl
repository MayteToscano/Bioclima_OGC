<bblocks://ogc.bioclima.coveragejson.bioclima-coverage> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "BioClima CoverageJSON profile" ;
    dct:abstract "Profile of the OGC CoverageJSON community standard for BioClima EBV and indicator datasets. Requires EPSG:4326 for spatial axes, allows an optional temporal axis with ISO 8601 values, and requires every parameter to declare an observedProperty.id resolvable in the BioClima ontology with labels in English, Spanish, Chinese and Romanian."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2024-11-01T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
