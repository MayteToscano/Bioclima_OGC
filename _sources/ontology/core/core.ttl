@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix bioclima: <https://maytetoscano.github.io/Bioclima_OGC/def/> .

bioclima: a owl:Ontology ;
    dcterms:title          "BioClima Core Ontology"@en ,
                           "Ontología núcleo BioClima"@es ,
                           "BioClima 核心本体"@zh ,
                           "Ontologia de bază BioClima"@ro ;
    dcterms:description    "Root ontology binding the bioclima namespace and importing the EBV, indicator, unit, entity-type and policy vocabularies."@en ,
                           "Ontología raíz que enlaza el espacio de nombres bioclima e importa los vocabularios de EBVs, indicadores, unidades, tipos de entidad y políticas."@es ,
                           "根本体,绑定 bioclima 命名空间并导入 EBV、指标、单位、实体类型和政策词汇表。"@zh ,
                           "Ontologie rădăcină care leagă spațiul de nume bioclima și importă vocabularele de EBV, indicatori, unități, tipuri de entități și politici."@ro ;
    dcterms:license        <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator        "BioClima Project" ;
    owl:versionInfo        "0.1.0" ;
    owl:imports            <https://maytetoscano.github.io/Bioclima_OGC/def/ebv/> ,
                           <https://maytetoscano.github.io/Bioclima_OGC/def/indicator/> ,
                           <https://maytetoscano.github.io/Bioclima_OGC/def/units/> ,
                           <https://maytetoscano.github.io/Bioclima_OGC/def/entity/> ,
                           <https://maytetoscano.github.io/Bioclima_OGC/def/policy/> .

# Top-level concept schemes
bioclima:ebv-scheme a skos:ConceptScheme ;
    dcterms:title "BioClima EBV vocabulary"@en .

bioclima:indicator-scheme a skos:ConceptScheme ;
    dcterms:title "BioClima Indicator vocabulary"@en .

bioclima:units-scheme a skos:ConceptScheme ;
    dcterms:title "BioClima Units vocabulary"@en .

bioclima:entity-scheme a skos:ConceptScheme ;
    dcterms:title "BioClima Entity-type vocabulary"@en .

bioclima:policy-scheme a skos:ConceptScheme ;
    dcterms:title "BioClima Policy vocabulary"@en .
