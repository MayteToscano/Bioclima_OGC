{
  "id": "https://maytetoscano.github.io/Bioclima_OGC/def/indicator/bioclimatic-zone",
  "label": {
    "en": "Bioclimatic zonification (PCI-based)",
    "es": "Zonificación bioclimática (basada en PCI)",
    "zh": "生物气候区划(基于 PCI)",
    "ro": "Zonificarea bioclimatică (pe baza PCI)"
  },
  "inputs": [
    {
      "role": "pci_raster",
      "ebv": "https://maytetoscano.github.io/Bioclima_OGC/bblock/ogc.bioclima.indicator.pci",
      "minYears": 1
    }
  ],
  "parameters": {
    "thresholds": {
      "stable":         { "min": -0.2,   "max":  0.2 },
      "mild_advance":   { "min": -0.5,   "max": -0.2 },
      "strong_advance": { "min": -1e9,   "max": -0.5 },
      "delay":          { "min":  0.2,   "max":  1e9 }
    },
    "category_iris": {
      "stable":         "https://maytetoscano.github.io/Bioclima_OGC/def/indicator/zone-stable",
      "mild_advance":   "https://maytetoscano.github.io/Bioclima_OGC/def/indicator/zone-mild-advance",
      "strong_advance": "https://maytetoscano.github.io/Bioclima_OGC/def/indicator/zone-strong-advance",
      "delay":          "https://maytetoscano.github.io/Bioclima_OGC/def/indicator/zone-delay"
    }
  },
  "implementation": {
    "language": "python",
    "entrypoint": "zonify.py#zonify",
    "version": "1.0.0",
    "requirements": "requirements.txt"
  },
  "output": {
    "unit": "categorical",
    "format": "GeoJSON"
  },
  "policyAlignment": [
    "https://maytetoscano.github.io/Bioclima_OGC/def/policy/kmgbf-target-1",
    "https://maytetoscano.github.io/Bioclima_OGC/def/policy/kmgbf-target-8"
  ]
}
