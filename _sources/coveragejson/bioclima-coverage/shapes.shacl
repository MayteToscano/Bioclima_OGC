@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix bioclima: <https://maytetoscano.github.io/Bioclima_OGC/def/> .

# A CoverageJSON parameter validated under this profile must reference an
# observedProperty whose IRI lives inside the BioClima namespace and whose
# label is available in the four supported languages.

bioclima:BioclimaCoverageParameterShape a sh:NodeShape ;
    sh:targetObjectsOf bioclima:hasParameter ;
    sh:property [
        sh:path bioclima:observedPropertyId ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:pattern "^https://maytetoscano\\.github\\.io/Bioclima_OGC/def/" ;
        sh:message "observedProperty.id must resolve to a SKOS concept in the BioClima ontology."@en
    ] .
