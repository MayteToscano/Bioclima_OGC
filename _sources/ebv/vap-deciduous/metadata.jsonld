  "@id": "https://maytetoscano.github.io/Bioclima_OGC/bblock/ogc.bioclima.ebv.vap-deciduous",
  "@type": "EBVDataset",
  "id": "10-deciduous",
  "naming_authority": "The German Centre for Integrative Biodiversity Research (iDiv) Halle-Jena-Leipzig",
  "title": {
    "en": "Start of Vegetation Active Period in Deciduous Vegetation of Finland",
    "es": "Inicio del periodo activo de vegetación en vegetación caducifolia de Finlandia",
    "zh": "芬兰落叶植被的植被活动期开始",
    "ro": "Începutul perioadei active a vegetației în vegetația foioasă din Finlanda"
  },
  "product_version": "2",
  "doi": "10.25829/xf8ek6",
  "date_created": "2020-11-04",
  "date_issued":  "2023-07-18",
  "summary": {
    "en": "Yearly maps (2001-2018) of the start of the vegetation active period in deciduous vegetation in Finland, derived from MODIS NDWI time series.",
    "es": "Mapas anuales (2001-2018) del inicio del periodo activo de vegetación en vegetación caducifolia en Finlandia, derivados de series temporales NDWI de MODIS.",
    "zh": "芬兰落叶植被植被活动期开始的年度地图(2001-2018),源自 MODIS NDWI 时间序列。",
    "ro": "Hărți anuale (2001-2018) ale începutului perioadei active a vegetației în vegetația foioasă din Finlanda, derivate din seriile temporale NDWI MODIS."
  },
  "keywords": ["Boreal", "Green-up", "Phenology", "Deciduous", "Start of season"],
  "references": ["https://doi.org/10.3390/rs8070580"],
  "source": "MODIS Terra Level 1B; NDWI computed and processed by Finnish Environment Institute.",

  "license": "https://creativecommons.org/licenses/by/4.0",

  "creator": {
    "name": "Kristin Böttcher",
    "email": "Kristin.Bottcher@ymparisto.fi",
    "institution": "The Finnish Environment Institute (SYKE)"
  },

  "ebv": {
    "ebv_class": "https://maytetoscano.github.io/Bioclima_OGC/def/ebv/ecosystem-functioning",
    "ebv_name":  "https://maytetoscano.github.io/Bioclima_OGC/def/ebv/ecosystem-phenology"
  },
  "ebv_entity": {
    "ebv_entity_type":  "https://maytetoscano.github.io/Bioclima_OGC/def/entity/deciduous-vegetation",
    "ebv_entity_scope": "Deciduous vegetation in Finland",
    "ebv_entity_names": ["Deciduous"]
  },
  "ebv_metric": {
    "vap_doy": {
      "standard_name": {
        "en": "Start of VAP (Day of Year)",
        "es": "Inicio del VAP (día del año)",
        "zh": "VAP 起始(年积日)",
        "ro": "Începutul VAP (ziua din an)"
      },
      "long_name": {
        "en": "The day when deciduous trees unfold new leaves in spring (green-up). Derived from MODIS NDWI time series.",
        "es": "Día en que los árboles caducifolios despliegan nuevas hojas en primavera (green-up). Derivado de series temporales NDWI de MODIS.",
        "zh": "落叶树春季展开新叶之日(返青)。源自 MODIS NDWI 时间序列。",
        "ro": "Ziua în care arborii foioși desfac frunzele noi primăvara (green-up). Derivat din seriile temporale NDWI MODIS."
      },
      "units": "https://maytetoscano.github.io/Bioclima_OGC/def/units/day-of-year"
    }
  },

  "geospatial": {
    "crs": "EPSG:4326",
    "lat_resolution": "0.066428063829064 degree",
    "lon_resolution": "0.066428063829064 degree",
    "lat_min": 57.7532613743371,
    "lat_max": 71.171730267808,
    "lon_min": 14.1011663430375,
    "lon_max": 35.2252906406799,
    "scope": "National",
    "description": "Finland"
  },
  "time_coverage": {
    "resolution": "P1Y",
    "start": "2001-01-01",
    "end":   "2018-01-01"
  },
  "ebv_domain": ["Terrestrial"],

  "comment": "Comparison with phenological network observations of birch bud break gave 7-day accuracy over 2001-2015 (84 site-years), with negligible bias (0.4 days).",

  "dataset": {
    "coverage": "examples/finland-vap-deciduous-2001-2018.covjson"
  },

